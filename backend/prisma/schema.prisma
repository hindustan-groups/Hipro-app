datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

generator client {
 provider = "prisma-client-js"
}

model Service {
    id          String       @id @default(uuid())
    code        String       @unique
    name        String
    description String
    icon        String
    iconImage   String?
    imageUrl    String?
    rating      Float
    subServices SubService[]
    created_at  DateTime     @default(now())
}

model SubService {
    id        String   @id @default(uuid())
    serviceId String
    service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    titleEn   String
    titleHi   String?
    desc      String
    checklist String[]
    created_at DateTime @default(now())
}

model user {
    id String @id @default(uuid())
    name String
    address UserAddress[]
    phoneNumber String? @unique
    email String? @unique
    password String?
    googleId String? @unique
    photoUrl String?
    authProvider String? @default("local")
    requests ServiceRequest[]
    created_at DateTime @default(now())
}

model UserAddress {
    id String @id @default(uuid())
    userId String
    user user @relation(fields: [userId], references: [id])
    type String @default("house") //HOUSE, APARTMENT ,OFFICE 
    address String
    city String
    pin String
    label String
}

// Service Damage Request Model (Store damage photos)
model ServiceRequest {
    id String @id @default(uuid()) 
    requestNumber String
    userId String
    user user @relation(fields: [userId], references: [id])
    servicecode String
    subServiceCode String
    issueDescription String
    urgency String
    status String
    mediaUrl String[]
    propertyType String
    propertySize String
    location String
    preferredDate String
    quotations Quotation[]
    preferredTime String
    addressline String @default("main Residance")
    created_at DateTime @default(now())  
}
model Quotation {
    id String @id @default(uuid())
    quoteNumber String @unique
    requestId String 
    request ServiceRequest @relation(fields: [requestId], references: [id])
    status String
    lineItem Json
    materialCost Float
    laborCost Float
    totalCost Float
    discount Float
    subtotal Float
    taxGST Float 
    grandtotal Float
    taxRate Float
    termsAndConditions String
    created_by String
    quotation_url String?
    estimatedTimeline String
    created_at DateTime @default(now())
}

