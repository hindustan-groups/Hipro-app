datasource db {
    provider = "postgresql"
    url = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}
model Service {
    id             String          @id @default(uuid())
    code           String          @unique
    name           String
    description    String
    icon           String
    iconImage      String?
    imageUrl       String?
    rating         Float
    isActive       Boolean         @default(true)
    cities         String[]        @default([])
    subServices    SubService[]
    requests       ServiceRequest[]
    directBookings DirectBooking[]
    created_at     DateTime        @default(now())
}

model SubService {
    id              String          @id @default(uuid())
    serviceId       String
    service         Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
    titleEn         String
    titleHi         String?
    desc            String
    image           String?
    checklist       String[]
    visitingCharge  Float           @default(0.0)
    bookNowEnabled  Boolean         @default(true)
    getQuoteEnabled Boolean         @default(true)
    isActive        Boolean         @default(true)
    cities          String[]        @default([])
    requiredFields  Json?
    requests        ServiceRequest[]
    directBookings  DirectBooking[]
    created_at      DateTime        @default(now())
}

model user {
    id             String           @id @default(uuid())
    name           String
    address        UserAddress[]
    phoneNumber    String?          @unique
    email          String?          @unique
    password       String?
    role           String           @default("USER") // USER, ADMIN, VENDOR
    googleId       String?          @unique
    photoUrl       String?
    authProvider   String?          @default("local")
    requests       ServiceRequest[]
    directBookings DirectBooking[]
    activities     CustomerActivity[]
    supportConversations SupportConversation[]
    supportAgent   SupportAgent?
    created_at     DateTime         @default(now())
}

model UserAddress {
    id      String @id @default(uuid())
    userId  String
    user    user   @relation(fields: [userId], references: [id], onDelete: Cascade)
    type    String @default("house") // HOUSE, APARTMENT, OFFICE 
    address String
    city    String
    pin     String
    label   String
}

// Service Damage Request Model (Robust with Foreign Keys & Unique Constraints)
model ServiceRequest {
    id               String       @id @default(uuid()) 
    requestNumber    String       @unique
    userId           String
    user             user         @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Direct Foreign Key References to prevent orphaned / corrupted records
    serviceId        String?
    service          Service?     @relation(fields: [serviceId], references: [id], onDelete: SetNull)
    subServiceId     String?
    subService       SubService?  @relation(fields: [subServiceId], references: [id], onDelete: SetNull)

    // Snapshots
    servicecode      String
    subServiceCode   String
    issueDescription String
    urgency          String       @default("NORMAL")
    status           String       @default("SUBMITTED")
    mediaUrl         String[]
    propertyType     String
    propertySize     String
    location         String
    latitude         Float?       // Live GPS coordinates
    longitude        Float?
    preferredDate    String
    preferredTime    String
    addressline      String?
    technicianId     String?
    technicianName   String?
    technicianPhone  String?
    technicianRole   String?

    // Vendor Assignment (Multi-panel vendor system)
    vendorId           String?
    cityId             String?      // City this request belongs to (multi-city routing)
    vendor             Vendor?      @relation("VendorAssignedJobs", fields: [vendorId], references: [id], onDelete: SetNull)
    assignedVendorName String?
    assignedQuotePrice Float?
    assignedBy         String?

    quotations       Quotation[]
    vendorQuotes     VendorQuote[]
    sharedVendors    VendorSharedRequest[]

    // Customer Service Rating & Review
    customerRating   Float?      // Customer star rating (1 to 5) after service completion
    customerReview   String?     // Customer review feedback
    ratedAt          DateTime?   // Timestamp when customer rated

    created_at       DateTime     @default(now())  
    updated_at       DateTime     @default(now()) @updatedAt
}

model Quotation {
    id                 String         @id @default(uuid())
    quoteNumber        String         @unique
    requestId          String 
    request            ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    status             String
    lineItem           Json
    materialCost       Float
    laborCost          Float
    totalCost          Float
    discount           Float
    subtotal           Float
    taxGST             Float 
    grandtotal         Float
    taxRate            Float
    advancePercentage  Float?         @default(50.0)
    advanceAmount      Float?
    termsAndConditions String
    created_by         String
    quotation_url      String?
    estimatedTimeline  String
    created_at         DateTime       @default(now())
}

// Direct Maintenance Booking Model (Pre-paid Instant Visits & On-Demand Service)
model DirectBooking {
    id                   String      @id @default(uuid())
    bookingNumber        String      @unique // e.g. HIP-1001
    userId               String?
    user                 user?       @relation(fields: [userId], references: [id], onDelete: SetNull)
    serviceId            String
    service              Service     @relation(fields: [serviceId], references: [id])
    subServiceId         String
    subService           SubService  @relation(fields: [subServiceId], references: [id])
    serviceName          String
    subServiceName       String
    subServiceDesc       String?
    customFieldAnswers   Json?       // Customer answers to required subservice questions

    customerName         String
    customerPhone        String
    customerAddress      String
    city                 String
    pincode              String?
    landmark             String?
    latitude             Float?      // Geo-coordinates for live technician dispatch
    longitude            Float?
    scheduledDate        String
    scheduledSlot        String

    technicianId         String?
    technicianName       String?
    technicianPhone      String?
    technicianRole       String?
    technicianPhoto      String?
    technicianRating     Float?
    assignedAt           DateTime?

    visitingCharge       Float       @default(0.0)
    onlinePaidAmount     Float       @default(199.0)
    additionalWorkAmount Float       @default(0.0)
    totalAmount          Float       @default(199.0)

    status               String      @default("CONFIRMED") // CONFIRMED, ASSIGNED, IN_PROGRESS, COMPLETED, CANCELLED
    paymentStatus        String      @default("PAID")      // PAID, REFUNDED
    paymentMethod        String      @default("ONLINE")
    razorpayPaymentId    String?
    razorpayOrderId      String?

    notes                String?
    cancelReason         String?
    statusHistory        Json?

    // Robust Refund Management
    refundStatus         String      @default("NONE") // NONE, INITIATED, PROCESSED, FAILED
    refundId             String?
    refundAmount         Float       @default(0.0)
    refundReason         String?
    refundArn            String?
    refundedAt           DateTime?

    // Customer Service Rating & Review
    customerRating       Float?      // Customer star rating (1 to 5) after service completion
    customerReview       String?     // Customer review feedback
    ratedAt              DateTime?   // Timestamp when customer rated

    created_at           DateTime    @default(now())
    updated_at           DateTime    @default(now()) @updatedAt
}

// City Master Model (Dynamic Multi-City Configuration like Zomato)
model City {
    id           String    @id @default(uuid())
    name         String    @unique // e.g. "Udaipur", "Bhilwara"
    state        String
    tagline      String    // e.g. "City of Lakes • Heritage, Villa & Home Care"
    imageUrl     String?   // City cover photo
    isActive     Boolean   @default(true)
    badge        String?   // "POPULAR", "INDUSTRIAL HUB"
    partnerCount Int       @default(0)
    serviceCount Int       @default(0)
    partners     Partner[]
    created_at   DateTime  @default(now())
    updated_at   DateTime  @default(now()) @updatedAt
}

// Service Specialist / Engineer Partner Model (City-Linked)
model Partner {
    id              String    @id @default(uuid())
    name            String
    phone           String    @unique
    role            String
    cityName        String    // e.g. "Udaipur", "Bhilwara"
    cityId          String?
    city            City?     @relation(fields: [cityId], references: [id], onDelete: SetNull)
    experienceYears Int       @default(0)
    rating          Float     @default(0.0)
    completedJobs   Int       @default(0)
    badge           String?   // "TOP ENGINEER", "WATERPROOFING MASTER"
    photo           String?
    specialties     String[]  @default([])
    isActive        Boolean   @default(true)
    created_at      DateTime  @default(now())
    updated_at      DateTime  @default(now()) @updatedAt
}

// Real-Time Customer Exploration & Cart Tracking Model
model CustomerActivity {
    id             String    @id @default(uuid())
    userId         String?
    user           user?     @relation(fields: [userId], references: [id], onDelete: SetNull)
    guestId        String?   // Anonymous or device UUID when not logged in
    customerName   String?
    customerPhone  String?
    customerEmail  String?
    city           String?
    eventType      String    // EXPLORING_SERVICE, VIEWED_SUBSERVICE, ADDED_TO_CART, REMOVED_FROM_CART, VIEWED_CART, PROCEED_TO_CHECKOUT
    serviceId      String?
    serviceName    String?
    subServiceId   String?
    subServiceName String?
    cartSnapshot   Json?     // Items currently in cart & visiting charge subtotal
    metadata       Json?     // Screen, device, extra attributes
    created_at     DateTime  @default(now())
    updated_at     DateTime  @default(now()) @updatedAt
}

// ==========================================
// AI Customer Support & Live Handoff System
// ==========================================

enum SupportConversationStatus {
    AI_ACTIVE
    WAITING_FOR_AGENT
    HUMAN_ACTIVE
    RESOLVED
}

enum SupportSenderType {
    CUSTOMER
    AI
    AGENT
    SYSTEM
}

enum SupportAgentAvailability {
    ONLINE
    OFFLINE
    BUSY
}

model SupportAgent {
    id            String                   @id @default(uuid())
    userId        String                   @unique
    user          user                     @relation(fields: [userId], references: [id], onDelete: Cascade)
    availability  SupportAgentAvailability @default(OFFLINE)
    isActive      Boolean                  @default(true)
    conversations SupportConversation[]    @relation("AssignedSupportAgent")
    handoffs      SupportHandoff[]
    createdAt     DateTime                 @default(now())
    updatedAt     DateTime                 @updatedAt
}

model SupportConversation {
    id              String                    @id @default(uuid())
    customerId      String
    customer        user                      @relation(fields: [customerId], references: [id], onDelete: Cascade)
    assignedAgentId String?
    assignedAgent   SupportAgent?             @relation("AssignedSupportAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)
    subject         String?
    status          SupportConversationStatus @default(AI_ACTIVE)
    handoffReason   String?
    messages        SupportMessage[]
    handoffs        SupportHandoff[]
    createdAt       DateTime                  @default(now())
    updatedAt       DateTime                  @updatedAt
    closedAt        DateTime?

    @@index([customerId, createdAt])
    @@index([status, updatedAt])
    @@index([assignedAgentId, status])
}

model SupportMessage {
    id             String              @id @default(uuid())
    conversationId String
    conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    senderType     SupportSenderType
    senderId       String?
    content        String
    createdAt      DateTime            @default(now())

    @@index([conversationId, createdAt])
}

model SupportHandoff {
    id             String              @id @default(uuid())
    conversationId String
    conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
    acceptedById   String?
    acceptedBy     SupportAgent?       @relation(fields: [acceptedById], references: [id], onDelete: SetNull)
    reason         String
    requestedAt    DateTime            @default(now())
    acceptedAt     DateTime?
    resolvedAt     DateTime?

    @@index([conversationId, requestedAt])
}

model SupportKnowledge {
    id        String   @id @default(uuid())
    title     String
    content   String
    category  String?
    isActive  Boolean  @default(true)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([isActive])
}

// ==========================================
// SUPER ADMIN & SYSTEM CREDENTIALS
// ==========================================

model Admin {
    id         String   @id @default(uuid())
    name       String   @default("Super Administrator")
    email      String   @unique
    password   String   // Hashed / verified password
    role       String   @default("ADMIN") // ADMIN, SUPER_ADMIN
    phone      String?
    isActive   Boolean  @default(true)
    created_at DateTime @default(now())
    updated_at DateTime @updatedAt

    @@index([email])
}

// ==========================================
// VENDOR MANAGEMENT SYSTEM
// Local contractors and adventure operators
// ==========================================

enum VendorCapacity {
    SMALL
    MEDIUM
    LARGE
}

model Vendor {
    id              String   @id @default(uuid())
    name            String
    businessName    String
    phone           String   @unique
    email           String?   @unique
    password        String?  // Optional vendor password
    passcode        String?  // 6-digit security PIN (hashed)
    state           String?  // Indian state / UT (e.g. "Rajasthan", "Maharashtra")
    city            String
    cityId          String?  // Links vendor to a specific city for multi-city routing
    category        String   @default("Services") // "Services" | "Adventure"
    specialization  String   // e.g. "Waterproofing", "Civil Construction", "Painting", "Paragliding"
    experience      String   // e.g. "8 Years"
    status          String   @default("active") // active, inactive, busy
    capacity        VendorCapacity @default(SMALL) // Work capability: SMALL | MEDIUM | LARGE
    maxConcurrentJobs Int      @default(5)        // Max active jobs vendor can handle at once
    currentJobCount   Int        @default(0)      // Current active assigned jobs
    rating          Float    @default(0.0)
    ratingsCount    Int      @default(0)
    minCharge       Float    @default(0.0)
    imageUrl        String?

    // Document Verification Fields
    aadhaarNumber     String?   // Aadhaar number
    aadhaarUrl        String?   // Uploaded Aadhaar document URL
    panNumber         String?   // PAN number
    panUrl            String?   // Uploaded PAN document URL
    bankPassbookUrl   String?   // Uploaded bank passbook URL
    documentsVerified Boolean   @default(false) // Admin verification status

    created_at      DateTime @default(now())
    updated_at      DateTime @updatedAt

    vendorQuotes    VendorQuote[]
    assignedJobs    ServiceRequest[] @relation("VendorAssignedJobs")
    sharedRequests  VendorSharedRequest[]
    ratings         VendorRating[]

    @@index([category])
    @@index([city])
    @@index([specialization])
    @@index([status])
    @@index([documentsVerified])
}

// Vendor Quotations - quotes submitted by vendors for customer requests
model VendorQuote {
    id               String   @id @default(uuid())
    requestId        String
    request          ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    vendorId         String
    vendor           Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    vendorName       String
    vendorBusiness   String?
    quotePrice       Float
    notes            String?
    estimatedTimeline String  @default("")
    status           String   @default("submitted") // submitted, accepted, rejected, assigned
    submittedBy      String?
    createdAt        DateTime @default(now())

    @@index([requestId])
    @@index([vendorId])
    @@index([status])
}


// VendorSharedRequest - Binds customer inspection requests to explicitly selected vendors
// Strictly enforces data isolation to prevent cross-vendor data breaching
model VendorSharedRequest {
    id          String         @id @default(uuid())
    requestId   String
    request     ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
    vendorId    String
    vendor      Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    sharedAt    DateTime       @default(now())
    sharedBy    String?        @default("Super Admin")
    notes       String?        // Admin instructions / dispatch notes
    status      String         @default("PENDING") // PENDING, QUOTED, DECLINED, ASSIGNED

    @@unique([requestId, vendorId])
    @@index([requestId])
    @@index([vendorId])
    @@index([status])
}

// Vendor Ratings & Customer Reviews
model VendorRating {
    id            String         @id @default(uuid())
    vendorId      String
    vendor        Vendor         @relation(fields: [vendorId], references: [id], onDelete: Cascade)
    userId        String?
    customerName  String
    customerPhone String?
    rating        Float          // 1.0 to 5.0
    review        String?
    serviceType   String         // "DIRECT_BOOKING" | "SERVICE_REQUEST"
    bookingId     String?        // ID of DirectBooking or ServiceRequest
    bookingNumber String?        // e.g. HIP-1001 or REQ-1793881172546
    created_at    DateTime       @default(now())

    @@index([vendorId])
    @@index([bookingId])
}
